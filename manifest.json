{
  "manifest_version": 3,
  "name": "Soft New Tab Pro",
  "version": "3.2.0",
  "description": "一个带时钟、搜索建议、快捷入口、设置面板和天气显示的新标签页插件",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://www.baidu.com/*",
    "https://duckduckgo.com/*",
    "https://v1.hitokoto.cn/*"
  ]
}
